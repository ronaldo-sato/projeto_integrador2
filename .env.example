# Copie este arquivo para .env e preencha com os dados do seu PostgreSQL.
# O .env NAO vai para o git (contem senha).
DB_NAME=projeto_integrador2
DB_USER=projeto_integrador
DB_PASSWORD=sua_senha_aqui
DB_HOST=localhost
DB_PORT=5432

# Desenvolvimento local: DEBUG=True. Em produção: DEBUG=False,
# SECRET_KEY nova e ALLOWED_HOSTS com o domínio do site
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=

# Banco na nuvem (Neon): o endereço completo substitui os DB_* acima.
# Deixe comentado para usar o PostgreSQL local
# DATABASE_URL=postgresql://usuario:senha@servidor/banco?sslmode=require
